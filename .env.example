EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the serverless API in api/ (see api/.env.example for that
# project's own env vars -- none of which belong here). Points at the
# Vercel deployment, e.g. https://your-api.vercel.app -- scheme included,
# no trailing slash and no /api suffix (lib/api-client.ts appends the
# endpoint path itself). Read by lib/api-client.ts, which throws at import
# time if it is missing.
EXPO_PUBLIC_API_BASE_URL=https://your-api.vercel.app
