EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the serverless API in api/ (see api/.env.example for that
# project's own env vars -- none of which belong here). Points at the
# Vercel deployment, e.g. https://vhub-api.vercel.app -- no trailing slash.
# Not read yet (lib/api-client.ts is still a stub); reserved for when the
# mobile app is wired up to call it.
EXPO_PUBLIC_API_BASE_URL=
