# V-HUB serverless API -- environment variables (Vercel Project Settings -> Environment Variables)
#
# NAMES ONLY. Never fill in real values here or commit this file with values.
# Every one of these lives ONLY as a Vercel env var for this api/ project --
# NEVER in the Expo app, NEVER prefixed EXPO_PUBLIC_, NEVER logged.

# --- Supabase (required) ---------------------------------------------------
# Same project the Expo app talks to. Project Settings -> API in the
# Supabase dashboard.
SUPABASE_URL=
# service_role key (NOT the anon/publishable key). Bypasses RLS -- this is
# exactly why it must never reach the mobile app. Used to: verify caller JWTs
# (auth.getUser), write match_score / v_score / verification_status /
# events_attended, write skill_match_cache, read/write push_tokens.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (Layer 2 -- optional; matching silently falls back to Layer 1
#     if this is unset, invalid, times out, or the daily quota is exhausted) -
GEMINI_API_KEY=
# Optional. Defaults to "gemini-2.5-flash" if unset.
GEMINI_MODEL=

# --- Resend (transactional email -- required for /api/application-status) -
RESEND_API_KEY=
# Verified sender, e.g. "V-HUB <notifications@yourdomain.org>"
RESEND_FROM=

# --- Expo push (required for /api/notifications dispatch) -----------------
# Optional but recommended: an Expo access token raises push-send rate
# limits and is required if "Enhanced Security for Push Notifications" is
# turned on for this Expo project. https://docs.expo.dev/push-notifications/sending-notifications/#additional-security
EXPO_ACCESS_TOKEN=

# --- Internal / ops ---------------------------------------------------------
# Shared secret for server-to-server calls that are NOT a volunteer/org JWT:
# the /api/notifications "send-event-reminders" action, meant to be triggered
# by a Vercel Cron Job. Vercel automatically sends
# "Authorization: Bearer <CRON_SECRET>" when this env var is set and the
# route is registered in vercel.json's "crons" list -- generate any long
# random string.
CRON_SECRET=

# Minimum Layer-1 total (0-100) for /api/match's "notify_candidates" mode to
# push a "new high-match outreach" alert to a verified volunteer. Optional,
# defaults to 75.
NOTIFY_MATCH_THRESHOLD=
