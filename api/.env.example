# V-HUB serverless API -- environment variables (Vercel Project Settings -> Environment Variables)
#
# NAMES ONLY. Never fill in real values here or commit this file with values.
# Every one of these lives ONLY as a Vercel env var for this api/ project --
# NEVER in the Expo app, NEVER prefixed EXPO_PUBLIC_, NEVER logged.

# --- Supabase (required) ---------------------------------------------------
# Same project the Expo app talks to. Project Settings -> API in the
# Supabase dashboard.
SUPABASE_URL=
# service_role key (NOT the anon/publishable key). Bypasses RLS -- this is
# exactly why it must never reach the mobile app. Used to: verify caller JWTs
# (auth.getUser), write match_score / v_score / verification_status /
# events_attended, write skill_match_cache, read/write push_tokens.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (Layer 2 -- optional; matching silently falls back to Layer 1
#     if this is unset, invalid, times out, or the daily quota is exhausted) -
GEMINI_API_KEY=
# Optional. Defaults to "gemini-2.5-flash" if unset.
GEMINI_MODEL=

# --- Email (Gmail SMTP -- required for /api/application-status) ------------
# V-HUB sends its own transactional email through a DEDICATED Gmail account,
# not Resend. Resend will only send from a verified domain; without one its
# sole usable sender delivers to the Resend account holder's own address and
# refuses everyone else, so every decision email reached one inbox. This
# project has no domain. See api/src/server/mailer.ts and
# docs/REPORT_NOTES.md.
#
# The dedicated Gmail address. This is ALSO the sender: Gmail overwrites the
# From header with the authenticated account, so it cannot be anything else.
GMAIL_USER=
# The 16-character Google APP PASSWORD (myaccount.google.com/apppasswords),
# with the display spaces stripped. NOT the account's own password.
# This credential grants full access to that mailbox -- read as well as send --
# which is why the account is a dedicated one holding nothing. Note that
# changing the Google account's password revokes it and mail stops until a new
# one is generated and pasted here AND into Supabase's SMTP settings.
GMAIL_APP_PASSWORD=
# Optional. The sender's display name, the only part of the sender that is
# ours to choose. Defaults to "V-HUB".
MAIL_FROM_NAME=

# Optional. Where an unexpected server failure (any 5xx) is emailed. LEAVE IT
# BLANK and nothing is sent -- error monitoring then does nothing but write a
# structured log line, which is the state this ships in. Setting it is a
# dashboard change and needs no deploy.
#
# Alerts are throttled to one per KIND of failure per 15 minutes, with the
# suppressed count carried in the next message, so a broken endpoint cannot
# send one email per request. They go out through the same Gmail account as
# everything else and therefore against the same ~500/day allowance.
#
# The email deliberately carries no request body and no identifiers -- only the
# route, the code and the message. The rest is in the server log, which does not
# leave Vercel. See lib/errorMonitor.ts and api/src/server/errorMonitor.ts.
ALERT_EMAIL=

# --- Expo push (required for /api/notifications dispatch) -----------------
# Optional but recommended: an Expo access token raises push-send rate
# limits and is required if "Enhanced Security for Push Notifications" is
# turned on for this Expo project. https://docs.expo.dev/push-notifications/sending-notifications/#additional-security
EXPO_ACCESS_TOKEN=

# --- Internal / ops ---------------------------------------------------------
# Shared secret for server-to-server calls that are NOT a volunteer/org JWT:
# the /api/notifications "send-event-reminders" action, meant to be triggered
# by a Vercel Cron Job. Vercel automatically sends
# "Authorization: Bearer <CRON_SECRET>" when this env var is set and the
# route is registered in vercel.json's "crons" list -- generate any long
# random string.
CRON_SECRET=

# Minimum Layer-1 total (0-100) for /api/match's "notify_candidates" mode to
# push a "new high-match outreach" alert to a verified volunteer. Optional,
# defaults to 75.
NOTIFY_MATCH_THRESHOLD=
